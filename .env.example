# ═══════════════════════════════════════════════════════════
# Telegram Bot (chỉ ẩn TOKEN — phần key sensitive)
# ═══════════════════════════════════════════════════════════
# Lấy từ @BotFather khi tạo bot
TELEGRAM_BOT_TOKEN=<FILL_BOT_TOKEN_HERE>
TELEGRAM_BOT_USERNAME=<FILL_BOT_USERNAME_HERE>
# Bot ID = phần số trước dấu ':' trong TOKEN; có thể để trống, script tự parse
TELEGRAM_BOT_ID=

# Force IPv4 (fix fetch timeout IPv6 trên một số VPS)
NODE_OPTIONS=--dns-result-order=ipv4first
