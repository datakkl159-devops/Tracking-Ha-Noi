# ═══════════════════════════════════════════════════════════
# Telegram Bot
# ═══════════════════════════════════════════════════════════
# Lấy từ @BotFather khi tạo bot
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFghijklmnopqrstuvwxyz
TELEGRAM_BOT_USERNAME=YourBotName
# Bot ID = phần số trước dấu : trong TOKEN. Có thể bỏ trống, script tự parse.
TELEGRAM_BOT_ID=

# ═══════════════════════════════════════════════════════════
# KinKin (vanchuyenkinkin.com) credentials
# ═══════════════════════════════════════════════════════════
KINKIN_USERNAME=your_username
KINKIN_PASSWORD=your_password
# Optional — chỉ dùng cho dev tool sniff-api.mjs
KINKIN_USER_ID=

# ═══════════════════════════════════════════════════════════
# Google Sheets logger (service account key)
# ═══════════════════════════════════════════════════════════
# Đường dẫn tuyệt đối tới file JSON service account
# (tạo service account ở Google Cloud → Download JSON → Share sheet với email service account)
GOOGLE_SA_KEY_FILE=/absolute/path/to/google-service-account.json

# ═══════════════════════════════════════════════════════════
# Node runtime
# ═══════════════════════════════════════════════════════════
# Fix: force IPv4 cho Telegram API — một số VPS có IPv6 bị block
NODE_OPTIONS=--dns-result-order=ipv4first
